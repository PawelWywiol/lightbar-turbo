{
  "name": "esp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check --write",
    "format": "biome format",
    "tsc": "tsc --noEmit",
    "madge": "madge --circular --extensions js,jsx,ts,tsx --exclude '(.turbo|node_modules)/.*' .",
    "test": "vitest",
    "test:changed": "vitest related --run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "config": "workspace:*",
    "cva": "npm:class-variance-authority@^0.7.1",
    "devices": "workspace:*",
    "@preact/compat": "^17.1.2",
    "preact": "^10.26.6",
    "ui": "workspace:*",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.6",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/preact": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.6",
    "tsconfig": "workspace:*",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "type": "module"
}
